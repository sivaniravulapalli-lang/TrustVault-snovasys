# Copy this file to .env and fill it in. Never commit .env.
DATABASE_URL=sqlite:///./dev.db
# At least 32 random characters. Make one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
UPLOAD_DIR=uploads
ADMIN_EMAIL=admin@example.com
# At least 12 characters, not a common password
ADMIN_PASSWORD=
# 1 only on your own machine: switches on /docs and /openapi.json
ENABLE_DOCS=0
